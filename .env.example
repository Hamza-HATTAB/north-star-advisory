# Resend API Configuration (Transactional Email Deliverability)
RESEND_API_KEY="re_your_resend_api_key_here"

# Cloudflare Turnstile Configuration (Bot & Spam Mitigation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA_your_site_key_here"
TURNSTILE_SECRET_KEY="0x4AAAAAAA_your_secret_key_here"

# Upstash Redis Configuration (Sliding-Window Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Analytics Configuration
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-YOURGA4ID"
NEXT_PUBLIC_CLARITY_PROJECT_ID="your_clarity_project_id"
